// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}
model ArrayElement {
    id    Int     @id @default(autoincrement())
    value Int
}
model stackelement {
    id    Int     @id @default(autoincrement())
    value Int
}

model queuelement {
    id    Int     @id @default(autoincrement())
    value Int
}
model linkedlist {
    id    Int     @id @default(autoincrement())
    value Int
}